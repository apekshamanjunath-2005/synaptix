# Synaptix Environment Variables Configuration

# Server Settings
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Google Gemini API (Configured in Milestone 2)
# Free tier API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Firebase Firestore (Configured in Milestone 4 - Spark Plan / Free Tier)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# Google Calendar MCP Integration (Configured in Milestone 5)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# OpenWeatherMap API (Configured in Milestone 6 - Free Tier)
OPENWEATHERMAP_API_KEY=
DEFAULT_CITY=Bengaluru

# Zero-Cost Protection & Safety Guards (Application-level limits)
MAX_DAILY_LLM_REQUESTS=100
MAX_TOOL_CALLS_PER_RUN=5
MAX_TOKENS_PER_RESPONSE=1024
